 *
 * For Thunderboot (TB) SPI NAND builds where the rkbin NAND SPL loads the
 * kernel directly. The SPL uses SDRAM 0x0-0x1fffff for its stack/heap, so
 * the kernel must be placed at 0x208000 (above the SPL region). The SPL
 * resolves FDT_ADDR_PLACEHOLDER (0xffffff00) but not KERNEL_ADDR_PLACEHOLDER
 * (0xffffff01), so kernel load/entry must be a real address.
 */

/dts-v1/;
/ {
    description = "FIT image with Linux kernel, FDT blob and resource (NAND TB)";

    images {
        fdt {
            data = /incbin/("fdt");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
            load = <0xffffff00>;

            hash {
                algo = "sha256";
                uboot-ignore = <1>;
            };
        };

        kernel {
            data = /incbin/("kernel");
            type = "kernel";
            arch = "arm";
            os = "linux";
            compression = "none";
            entry = <0x00208000>;
            load = <0x00208000>;

            hash {
                algo = "sha256";
                uboot-ignore = <1>;
            };
        };

        resource {
            data = /incbin/("resource");
            type = "multi";
            arch = "arm";
            compression = "none";

            hash {
                algo = "sha256";
                uboot-ignore = <1>;
            };
        };
    };

    configurations {
        default = "conf";

        conf {
            rollback-index = <0x00>;
            fdt = "fdt";
            kernel = "kernel";
            multi = "resource";

            signature {
                algo = "sha256,rsa2048";
                padding = "pss";
                key-name-hint = "dev";
                sign-images = "fdt", "kernel", "multi";
            };
        };
    };
};
