#include <dt-bindings/input/input.h>

/ {
	chosen {
		/*  bootargs = "earlycon=uart8250,mmio32,0x20540000 console=ttyFIQ0 root=/dev/mmcblk0p5 rootfstype=ext4 rootwait snd_soc_core.prealloc_buffer_size_kbytes=16 coherent_pool=32K"; */
		bootargs = "earlycon=uart8250,mmio32,0x20540000 console=ttyS0,115200";
	};

	acodec_sound: acodec-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rv1103b-acodec";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,cpu {
			sound-dai = <&sai>;
		};
		simple-audio-card,codec {
			sound-dai = <&acodec>;
		};
	};

	restart-poweroff {
		compatible = "restart-poweroff";
	};

	vcc_sys: vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_sys>;
	};

	vcc_3v3: vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys>;
	};

	vdd_logic: vdd-logic {
		compatible = "regulator-fixed";
		regulator-name = "vdd_logic";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc_sys>;
	};

	vdd_npu: vdd_arm: vdd-arm {
		compatible = "regulator-fixed";
		regulator-name = "vdd_arm";
		regulator-min-microvolt = <950000>;
		regulator-max-microvolt = <950000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc_sys>;
	};

	/* Omega4 module: Wi-Fi/BT (AIC8800 SDIO) */
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_pwr_wf>;
		post-power-on-delay-ms = <300>;

		/* real Wi-Fi power/reset: PWR_WF = GPIO0_A0 */
		reset-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_LOW>;
	};

	wifi: wifi {
		compatible = "wlan-platdata";
		wifi_chip_type = "aic8800";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_wake_gpio>;
		WIFI,poweren_gpio = <&gpio0 RK_PA3 GPIO_ACTIVE_HIGH>; /* host -> WiFi wake/enable */
		status = "okay";
	};

	bluetooth: bluetooth {
		compatible = "aic,aic8800-btlpm";
		pinctrl-names = "default";
		pinctrl-0 = <&bt_host_wake_irq &bt_wake_gpio>;
		bt_hostwake = <&gpio2 RK_PA7 GPIO_ACTIVE_HIGH>; /* BT -> host wake (required by driver) */
		bt_wake = <&gpio0 RK_PA4 GPIO_ACTIVE_HIGH>;     /* host -> BT wake */
		uart_index = <2>;
		status = "okay";
	};
};

&acodec {
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&fiq_debugger {
	rockchip,irq-mode-enable = <1>;
	status = "okay";
};

&gmac {
	status = "okay";
};

&mpp_srv {
	status = "okay";
};

&mpp_vcodec {
	status = "okay";
};

&npu {
	rknpu-supply = <&vdd_npu>;
	status = "okay";
};

// we might want to have this as GPIO
&pwm0_4ch_0 {
	status = "disabled";
};

// we might want to have this as GPIO
&pwm0_4ch_3 {
	status = "disabled";
};

&rga2 {
	status = "okay";
};

&rkdvbm {
	status = "okay";
};

&rkvenc {
	status = "okay";
};

&rmii_phy {
	bgs,increment = <0>;
};

&rng {
	status = "okay";
};

&rtc {
	status = "okay";
};

&sai {
	status = "okay";
};

&saradc{
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&tsadc {
	status = "okay";
};

// UART0 can be exposed with M0 or M2, so we do not set a default
&uart0 {
 	status = "disabled";
};

// UART1 is only exposed on Omega4 in M1 state, so set this as default
&uart1 {
	status = "disabled";
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart1m1_xfer_pins>;
};

&u2phy {
	status = "okay";
};

&u2phy_otg {
	rockchip,vbus-always-on;
	status = "okay";
};

&usbdrd {
	status = "okay";
};

&usbdrd_dwc3 {
	extcon = <&u2phy>;
	status = "okay";
};

&pinctrl {
	sdio-pwrseq {
		wifi_pwr_wf: wifi-pwr-wf {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wifi {
		wifi_wake_gpio: wifi-wake-gpio {
			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	bluetooth {
		bt_host_wake_irq: bt-host-wake-irq {
			rockchip,pins = <2 RK_PA7 RK_FUNC_GPIO &pcfg_pull_down>;
		};
		bt_wake_gpio: bt-wake-gpio {
			rockchip,pins = <0 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};



/* Omega4 module specific HW use */

// UART2 M1 is connected to WiFi/BT, not available on the EVB
&uart2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m1_xfer_pins &uart2m1_ctsn_pins &uart2m1_rtsn_pins>;
};

// FSPI0 (aliased as SPI1) is connected to on-board W25N02KVZEIR QSPI NAND flash
&fspi0 {
	status = "okay";
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>; // can fast quad read
		spi-tx-bus-width = <1>; // cannot quad write
	};
};
