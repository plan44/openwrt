#include <dt-bindings/input/input.h>

/ {
	chosen {
		/*  bootargs = "earlycon=uart8250,mmio32,0x20540000 console=ttyFIQ0 root=/dev/mmcblk0p5 rootfstype=ext4 rootwait snd_soc_core.prealloc_buffer_size_kbytes=16 coherent_pool=32K"; */
		bootargs = "earlycon=uart8250,mmio32,0x20540000 console=ttyS0,115200";
	};

	acodec_sound: acodec-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rv1103b-acodec";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,cpu {
			sound-dai = <&sai>;
		};
		simple-audio-card,codec {
			sound-dai = <&acodec>;
		};
	};

	restart-poweroff {
		compatible = "restart-poweroff";
	};

	vcc_sys: vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_sys>;
	};

	vcc_3v3: vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys>;
	};

	vdd_logic: vdd-logic {
		compatible = "pwm-regulator";
		pwms = <&pwm0_4ch_3 0 5000 1>;
		regulator-name = "vdd_logic";
		regulator-min-microvolt = <810000>;
		regulator-max-microvolt = <1006000>;
		regulator-init-microvolt = <900000>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-up-us = <250>;
		pwm-supply = <&vcc_sys>;
	};

	vdd_npu: vdd_arm: vdd-arm {
		compatible = "pwm-regulator";
		pwms = <&pwm0_4ch_0 0 5000 1>;
		regulator-name = "vdd_arm";
		regulator-min-microvolt = <717000>;
		regulator-max-microvolt = <1102000>;
		regulator-init-microvolt = <950000>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-up-us = <250>;
		pwm-supply = <&vcc_sys>;
	};
};


/* Omega4 module specific (and unalterable) pin use */

&gpio0 {
  gpio-line-names =
    "Wifi_PWR", "A1_d", "A2_d", "Host_wake_Wifi", "Host_wake_BT", "A5_d", "A6_u";
};

&gpio1 {
  gpio-line-names =
    "FSPI_D3", "FSPI_D0_BOOT", "FSPI_D1", "FSPI_D2", "FSPI_CLK", "FSPI_CMD", "A6_u", "A7_d",
    "B0_d", "B1_d", "B2_d", "B3_d", "B4_d", "B5_d", "B6_d", "B7_d",
    "C0_d", "C1_u", "C2_u", "C3_u", "C4_u", "C5_u", "C6_u", "",
    "D0_u", "D1_u", "D2_u", "D3_u", "D4_u", "D5_u";
};

&gpio2 {
  gpio-line-names =
    "Wifi_D1", "Wifi_D0", "Wifi_CLK", "Wifi_CMD", "Wifi_D3", "Wifi_D2", "Wifi_wake_host", "BT_wake_host",
    "BT_HCI_TX", "BT_HCI_RX", "BT_HCI_RTS", "BT_HCI_CTS";
};


/* default enables/disables */


&acodec {
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&fiq_debugger {
	rockchip,irq-mode-enable = <1>;
	status = "okay";
};

&gmac {
	status = "okay";
};

&mpp_srv {
	status = "okay";
};

&mpp_vcodec {
	status = "okay";
};

&npu {
	rknpu-supply = <&vdd_npu>;
	status = "okay";
};

// we might want to have this as GPIO
&pwm0_4ch_0 {
	status = "disabled";
};

// we might want to have this as GPIO
&pwm0_4ch_3 {
	status = "disabled";
};

&rga2 {
	status = "okay";
};

&rkdvbm {
	status = "okay";
};

&rkvenc {
	status = "okay";
};

&rmii_phy {
	bgs,increment = <0>;
};

&rng {
	status = "okay";
};

&rtc {
	status = "okay";
};

&sai {
	status = "okay";
};

&saradc{
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&tsadc {
	status = "okay";
};

// UART0 can be exposed with M0 or M2, so we do not set a default
&uart0 {
 	status = "disabled";
};

// UART1 is only exposed on Omega4 in M1 state, so set this as default
&uart1 {
	status = "disabled";
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart1m1_xfer_pins>;
};

&u2phy {
	status = "okay";
};

&u2phy_otg {
	rockchip,vbus-always-on;
	status = "okay";
};

&usbdrd {
	status = "okay";
};

&usbdrd_dwc3 {
	extcon = <&u2phy>;
	status = "okay";
};



/* Omega4 module specific HW use */

// UART2 M1 is connected to WiFi/BT, not available on the EVB
&uart2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m1_xfer_pins &uart2m1_ctsn_pins &uart2m1_rtsn_pins>;
};

// FSPI0 (aliased as SPI1) is connected to on-board W25N02KVZEIR QSPI NAND flash
&fspi0 {
	status = "okay";
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>; // can fast quad read
		spi-tx-bus-width = <1>; // cannot quad write
	};
};

