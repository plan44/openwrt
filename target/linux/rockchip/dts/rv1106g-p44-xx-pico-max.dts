/dts-v1/;

#include "rv1106.dtsi"
#include "rv1106-evb.dtsi"
#include "rv1106-luckfox-pico-pro-max-ipc.dtsi"

/ {
	model = "P44-xx-GW";
	compatible = "plan44,p44-xx-pico-max", "luckfox,rv1106-luckfox-pico-max", "rockchip,rv1106";

	leds {
		compatible = "gpio-leds";

		status1 {
			label = "p44:green:status1";
			gpios = <&gpio2 RK_PA3 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		status2 {
			label = "p44:red:status2";
			gpios = <&gpio2 RK_PA2 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

	};

};



/**********FLASH**********/
&sfc {
	status = "okay";
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/**********SDMMC**********/
&sdmmc {
	max-frequency = <50000000>;
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	status = "okay";
};

