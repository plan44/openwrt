/dts-v1/;

#include "rv1103.dtsi"
#include "rv1106-evb.dtsi"
#include "rv1103-luckfox-pico-ipc.dtsi"

/ {
	model = "Luckfox Pico Mini";
	/* Mini B listed first; Mini A listed for sysupgrade compatibility.
	 * Both variants are hardware-identical except for onboard SPI NAND,
	 * which is disabled below. A single SD image boots either board. */
	compatible = "luckfox,rv1103-luckfox-pico-mini-b", "luckfox,rv1103-luckfox-pico-mini-a", "rockchip,rv1103";

	chosen {
		/* earlycon + console only; root/blkdevparts come from U-Boot env sys_bootargs */
		bootargs = "earlycon=uart8250,mmio32,0xff4c0000 console=ttyS2,115200n8 loglevel=8 ignore_loglevel";
	};
};

/* fiq-debugger is a vendor-only feature with no upstream driver; disable to
 * suppress "Dropping the fwnode link to /interrupt-controller" at boot. */
&fiq_debugger {
	status = "disabled";
};

/**********SFC**********/
/* Enabled so the NAND MTD device is available for recovery/bad-block scanning
 * on Mini B. On Mini A (no onboard flash) the spi-nand probe will fail with
 * "unknown raw ID ff ff ff ff ..." — this is expected and harmless. */
&sfc {
	status = "okay";
	/* Pinctrl required on SD boot — rkbin only sets up SFC pins for NAND
	 * boot; when booting from SD the kernel must mux them explicitly. */
	pinctrl-names = "default";
	pinctrl-0 = <&fspi_pins &fspi_cs0>;
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/**********SDMMC**********/
&sdmmc {
	max-frequency = <50000000>;
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	status = "okay";
};

/**********ETH**********/
/* RV1103 has an integrated 10/100 EPHY; the Mini exposes only the MDI
 * differential pairs (TXP/TXN/RXP/RXN) on castellated pads. A carrier
 * board with external magnetics + RJ45 is required for a physical link.
 * The driver probes cleanly without magnetics (MDIO lives inside the SoC)
 * and the interface just reports link down until one is attached. */
&gmac {
	status = "okay";
};

/**********USB**********/
&usbdrd_dwc3 {
	/* PHY_ROCKCHIP_INNO_USB2 not yet patched in; drop PHY/extcon refs so
	 * DWC3 doesn't EPROBE_DEFER indefinitely. Bootloader initialises the
	 * USB PHY; peripheral-mode gadget works without kernel PHY driver. */
	/delete-property/ phys;
	/delete-property/ phy-names;
	/delete-property/ extcon;
	dr_mode = "peripheral";
	status = "okay";
};

/**********SPI**********/
/* SPI0_M0 */
&spi0 {
	status = "disabled";
	spidev@0 {
		spi-max-frequency = <50000000>;
	};
};

/**********I2C**********/
/* I2C3_M1 */
&i2c3 {
	status = "disabled";
	clock-frequency = <100000>;
};

/**********UART**********/
/* UART2_M1 — debug console; must be enabled so the 8250 driver claims the
 * UART2 clock before clk_disable_unused() runs, keeping the console alive. */
&uart2 {
	status = "okay";
};

/* UART3_M1 */
&uart3 {
	status = "disabled";
};

/* UART4_M1 */
&uart4 {
	status = "disabled";
};

/**********PWM**********/
/* PWM1_M0 */
&pwm1 {
	status = "disabled";
};

/* Disable camera sensors from ipc DTSI — sc4336 and sc530ai both claim
 * i2c4 address 0x30 which causes -EBUSY at boot. No onboard camera;
 * enable the appropriate sensor in a board overlay if needed. */
&sc4336 {
	status = "disabled";
};

&sc530ai {
	status = "disabled";
};
