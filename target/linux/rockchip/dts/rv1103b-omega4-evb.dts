/dts-v1/;

#include "rv1103b.dtsi"
#include "rv1103b-pinctrl.dtsi"
#include "rv1103b-omega4.dtsi"

/ {
	model = "Omega4 EVB P2";
	compatible = "onion,rv1103b-omega4-evb", "rockchip,rv1103b";

	aliases {
		led-boot = &sys_led;
		led-failsafe = &sys_led;
		led-running = &sys_led;
		led-upgrade = &sys_led;
	};

	leds {
		compatible = "gpio-leds";

		sys_led: sys-led {
			gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
			label = "sys";
			default-state = "on";
		};
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_pwr_wf>;
		post-power-on-delay-ms = <300>;

		/* real Wi-Fi power/reset: PWR_WF = GPIO0_A0 */
		reset-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_LOW>;
	};


	// wireless_wlan: wireless-wlan {
	// 	compatible = "wlan-platdata";
	// 	wifi_chip_type = "aic8800";
	// 	pinctrl-names = "default";
	// 	pinctrl-0 = <&wifi_host_wake_irq>;
	// 	WIFI,host_wake_irq = <&gpio0 RK_PA3 GPIO_ACTIVE_HIGH>;
	// 	status = "okay";
	// };

	vcc3v3_sd: vcc3v3-sd {
		compatible = "regulator-fixed";
		gpio = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
		regulator-name = "vcc3v3_sd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		pinctrl-names = "default";
		pinctrl-0 = <&sdmmc_pwren>;
		vin-supply = <&vcc_3v3>;
	};

	vccio_sd: vccio-sd {
		compatible = "regulator-gpio";
		regulator-name = "vccio_sd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&gpio0 RK_PA3 GPIO_ACTIVE_HIGH>;
		states = <3300000 1
			  1800000 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&sdmmc_volt>;
	};

// That's the Rockchip EVB module, Omega4 has another module
// 	wireless_wlan: wireless-wlan {
// 		compatible = "wlan-platdata";
// 		wifi_chip_type = "rtl8189fs";
// 		pinctrl-names = "default";
// 		pinctrl-0 = <&wifi_host_wake_irq>;
// 		WIFI,host_wake_irq = <&gpio2 RK_PA6 GPIO_ACTIVE_HIGH>;
// 		status = "okay";
// 	};
};

&pinctrl {
	sdmmc {
		/omit-if-no-ref/
		sdmmc_pwren: sdmmc-pwren {
			rockchip,pins = <0 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		/omit-if-no-ref/
		sdmmc_volt: sdmmc-volt {
			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

// That's for the Rockchip EVB module, Omega4 has another module
// 	wireless-wlan {
// 		wifi_host_wake_irq: wifi-host-wake-irq {
// 			rockchip,pins = <2 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
// 		};
// 	};
	sdio-pwrseq {
		wifi_pwr_wf: wifi-pwr-wf {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};


/**********FLASH**********/

// is on the omega4 module itself, not defined here

/**********SDMMC**********/
&sdmmc0 {

	status = "okay";
};

&sdmmc1 {
	max-frequency = <150000000>;
	no-sd;
	no-mmc;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	vmmc-supply = <&vcc3v3_sd>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_cmd_pins &sdmmc1_clk_pins &sdmmc1_bus4_pins>;
	status = "okay";
};


/**********ETH**********/
&gmac {
	status = "okay";
};

/**********USB**********/
&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

