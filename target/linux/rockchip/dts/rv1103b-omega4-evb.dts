/**********UART**********/

// UART0  M0 is the system console on the O4-EVB connected to CP2104
&uart0 {
 	status = "okay";
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart0m0_xfer_pins>;
};


// UART1 M1 is available, no predefined use
