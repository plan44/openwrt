+static struct rockchip_clk_branch rv1103b_armclk __initdata =
+	MUX(ARMCLK, "armclk", mux_armclk_p, CLK_IS_CRITICAL | CLK_SET_RATE_PARENT,
+			RV1103B_CORECLKSEL_CON(0), 1, 1, MFLAGS);
+
+static void __iomem *rv1103b_cru_base;
+static struct rockchip_clk_provider *cru_ctx;
+
+void rv1103b_dump_cru(void)
+{
+	if (rv1103b_cru_base) {
+		pr_warn("CRU:\n");
+		print_hex_dump(KERN_WARNING, "", DUMP_PREFIX_OFFSET,
+			       32, 4, rv1103b_cru_base,
+			       0x588, false);
+	}
+}
+EXPORT_SYMBOL_GPL(rv1103b_dump_cru);
+
+static int rv1103b_clk_panic(struct notifier_block *this,
+			     unsigned long ev, void *ptr)
+{
+	rv1103b_dump_cru();
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block rv1103b_clk_panic_block = {
+	.notifier_call = rv1103b_clk_panic,
+};
+
+static void __init rv1103b_clk_init(struct device_node *np)
+{
+	struct rockchip_clk_provider *ctx;
+	void __iomem *reg_base;
+
+	reg_base = of_iomap(np, 0);
+	if (!reg_base) {
+		pr_err("%s: could not map cru region\n", __func__);
+		return;
+	}
+
+	rv1103b_cru_base = reg_base;
+
+	ctx = rockchip_clk_init(np, reg_base, CLK_NR_CLKS);
+	if (IS_ERR(ctx)) {
+		pr_err("%s: rockchip clk init failed\n", __func__);
+		iounmap(reg_base);
+		return;
+	}
+	cru_ctx = ctx;
+
+	rockchip_clk_register_plls(ctx, rv1103b_pll_clks,
+				   ARRAY_SIZE(rv1103b_pll_clks),
+				   RV1103B_GRF_SOC_STATUS0);
+
+	rockchip_clk_register_branches(ctx, rv1103b_clk_branches,
+				       ARRAY_SIZE(rv1103b_clk_branches));
+
+	rockchip_clk_register_armclk_v2(ctx, &rv1103b_armclk,
+					rv1103b_cpuclk_rates,
+					ARRAY_SIZE(rv1103b_cpuclk_rates));
+
+	rockchip_register_softrst(np, CLK_NR_SRST, reg_base + RV1103B_PERISOFTRST_CON(0),
+				  ROCKCHIP_SOFTRST_HIWORD_MASK);
+
+	rockchip_register_restart_notifier(ctx, RV1103B_GLB_SRST_FST, NULL);
+
+	rockchip_clk_of_add_provider(np, ctx);
+
+	atomic_notifier_chain_register(&panic_notifier_list,
+				       &rv1103b_clk_panic_block);
+	if (!rk_dump_cru)
+		rk_dump_cru = rv1103b_dump_cru;
+
+	/* pvtpll src init */
+	writel_relaxed(PVTPLL_SRC_SEL_PVTPLL, reg_base + RV1103B_CORECLKSEL_CON(0));
+	writel_relaxed(PVTPLL_SRC_SEL_PVTPLL, reg_base + RV1103B_NPUCLKSEL_CON(0));
+	writel_relaxed(PVTPLL_SRC_SEL_PVTPLL, reg_base + RV1103B_VICLKSEL_CON(0));
+	writel_relaxed(PVTPLL_SRC_SEL_PVTPLL, reg_base + RV1103B_VEPUCLKSEL_CON(0));
+}
+
+CLK_OF_DECLARE(rv1103b_cru, "rockchip,rv1103b-cru", rv1103b_clk_init);
+
+#ifdef MODULE
+struct clk_rv1103b_inits {
+	void (*inits)(struct device_node *np);
+};
+
+static const struct clk_rv1103b_inits clk_rv1103b_init = {
+	.inits = rv1103b_clk_init,
+};
+
+static const struct of_device_id clk_rv1103b_match_table[] = {
+	{
+		.compatible = "rockchip,rv1103b-cru",
+		.data = &clk_rv1103b_init,
+	},
+	{ }
+};
+MODULE_DEVICE_TABLE(of, clk_rv1103b_match_table);
+
+static int __init clk_rv1103b_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	const struct of_device_id *match;
+	const struct clk_rv1103b_inits *init_data;
+
+	match = of_match_device(clk_rv1103b_match_table, &pdev->dev);
+	if (!match || !match->data)
+		return -EINVAL;
+
+	init_data = match->data;
+	if (init_data->inits)
+		init_data->inits(np);
+
+	return 0;
+}
+
+static struct platform_driver clk_rv1103b_driver = {
+	.driver		= {
+		.name	= "clk-rv1103b",
+		.of_match_table = clk_rv1103b_match_table,
+	},
+};
+builtin_platform_driver_probe(clk_rv1103b_driver, clk_rv1103b_probe);
+
+MODULE_DESCRIPTION("Rockchip RV1103B Clock Driver");
+MODULE_LICENSE("GPL");
+#endif /* MODULE */
