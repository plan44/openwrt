#!/bin/sh
# Create /tmp/fw_env.config from devicetree compatible string.
# /etc/fw_env.config is a symlink to /tmp/fw_env.config so fw_printenv finds
# the correct env partition during preinit (before overlay mounts).

create_fw_env_config() {
	local compat
	compat=$(cat /proc/device-tree/compatible 2>/dev/null | tr '\0' '\n' | head -1)
	case "$compat" in
	luckfox,rv1103-luckfox-pico-mini-b | luckfox,rv1103-luckfox-pico-mini-a)
		# SD boot (combined Mini profile or legacy Mini A/B-SD)
		printf '/dev/mmcblk1\t0x0\t0x8000\n' > /tmp/fw_env.config
		;;
	luckfox,rv1103-luckfox-pico-mini-nand)
		# NAND boot (Mini B NAND profile)
		printf '/dev/mtd0\t0x0\t0x40000\t0x20000\n' > /tmp/fw_env.config
		;;
	esac
}

boot_hook_add preinit_main create_fw_env_config
